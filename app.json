{
  "expo": {
    "name": "chaybo",
    "slug": "chaybo",
    "scheme": "chaybo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08090A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chaybo.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "chaybo dùng cảm biến chuyển động để đếm nhịp bước chân khi bạn chạy.",
        "NSPhotoLibraryUsageDescription": "chaybo cần truy cập thư viện ảnh để bạn đính kèm ảnh vào buổi chạy.",
        "NSPhotoLibraryAddUsageDescription": "chaybo cần quyền lưu ảnh chia sẻ vào thư viện ảnh của bạn.",
        "NSFaceIDUsageDescription": "chaybo dùng Face ID để khoá ứng dụng và bảo vệ dữ liệu chạy bộ của bạn."
      }
    },
    "android": {
      "package": "com.chaybo.app",
      "adaptiveIcon": {
        "backgroundColor": "#08090A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#08090A",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "chaybo dùng vị trí của bạn để ghi lại lộ trình và quãng đường chạy.",
          "locationAlwaysAndWhenInUsePermission": "chaybo dùng vị trí của bạn ngay cả khi app chạy nền để ghi lại buổi chạy.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b0e26abd-a9a3-4ebc-b7a4-b438f75e1f50"
      }
    },
    "owner": "kh4n9"
  }
}
